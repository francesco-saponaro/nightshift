{
  "name": "nightshift",
  "private": true,
  "version": "0.1.0",
  "description": "An on-call engineer that never sleeps: an error arrives from the error tracker, a reproduction is written, a coding agent fixes it in its own checkout, the fix is verified and reviewed, and a pull request opens.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm -C apps/sample test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "build:demo": "VITE_DEMO=1 pnpm -r build",
    "dev:dashboard": "pnpm -C apps/dashboard dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
