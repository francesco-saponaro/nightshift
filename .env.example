# Nightshift reads these. Copy to .env and fill in what you have; nothing here is required for the dry run.

# The coding agent. Without it the pipeline runs in dry-run mode and replays the recorded transcripts from fixtures/.
ANTHROPIC_API_KEY=

# Webhook secrets. Sentry signs every delivery with the client secret of its internal integration;
# PostHog does not sign, so Nightshift expects the shared secret in an x-nightshift-signature header.
SENTRY_CLIENT_SECRET=
POSTHOG_WEBHOOK_SECRET=

# Where incidents, runs and the queue live. Unset: PGlite in memory. pglite:<dir>: PGlite on disk. postgres://...: PostgreSQL.
DATABASE_URL=

# Where the agent works. Unset: a git worktree under apps/agent/worktrees/. Set: a cloud sandbox that takes the same commands over HTTP.
NIGHTSHIFT_SANDBOX_URL=

# How the worktree gets its dependencies.
NIGHTSHIFT_INSTALL=pnpm install --frozen-lockfile --prefer-offline

# The sample app. A comma-separated list of the seeded bugs to switch on: empty-title, date-off-by-one, double-submit.
SAMPLE_BUGS=
