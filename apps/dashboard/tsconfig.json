{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@agent/*": [
        "../agent/src/*"
      ],
      "@fixtures/*": [
        "../../fixtures/*"
      ],
      "@skills/*": [
        "../../packages/skills/skills/*"
      ]
    },
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
