{
  "name": "@nightshift/sample",
  "version": "0.1.0",
  "description": "The app Nightshift looks after: a small to-do list with a Fastify API, a React front and three seeded bugs behind flags.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    "./flags": {
      "types": "./dist/server/flags.d.ts",
      "import": "./dist/server/flags.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
