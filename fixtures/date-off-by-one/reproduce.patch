+import { afterEach, describe, expect, it } from "vitest";
+import { buildApp, type SampleApp } from "../src/server/app.js";
+
+// Incident inc-ec6c6789, PostHog, 2026-11-16 20:21 UTC: the browser reported "daysLeft for 2026-11-17 is 0 but the
+// calendar says 1" after POST /api/todos while SAMPLE_BUGS=date-off-by-one. A to-do due tomorrow must say so whatever
+// the time of day, and one due today is not overdue until tomorrow.
+
+const evening = () => new Date("2026-11-16T20:21:49.245Z");
+
+let app: SampleApp;
+afterEach(async () => {
+  await app?.close();
+});
+
+describe("incident inc-ec6c6789: the day count after midday", () => {
+  it("counts a to-do due tomorrow as 1 day away at 20:21", async () => {
+    app = await buildApp({ bugs: new Set(["date-off-by-one"]), now: evening });
+    const res = await app.inject({ method: "POST", url: "/api/todos", payload: { title: "Call the bank", dueOn: "2026-11-17" } });
+    expect(res.statusCode).toBe(201);
+    expect(res.json().daysLeft).toBe(1);
+  });
+
+  it("counts a to-do due today as 0, not overdue, at the same hour", async () => {
+    app = await buildApp({ bugs: new Set(["date-off-by-one"]), now: evening });
+    const res = await app.inject({ method: "POST", url: "/api/todos", payload: { title: "Call the bank", dueOn: "2026-11-16" } });
+    expect(res.json().daysLeft).toBe(0);
+  });
+});
